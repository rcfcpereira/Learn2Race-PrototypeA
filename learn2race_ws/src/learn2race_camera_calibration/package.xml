<?xml version="1.0"?>
<package format="3">
  <!-- Camera calibration workflows for the stereo Raspberry Pi Camera v2 pair. -->
  <name>learn2race_camera_calibration</name>
  <version>0.1.0</version>
  <description>Stereo camera calibration launches and defaults for Learn2Race.</description>
  <maintainer email="1181915@isep.ipp.pt">Ruben Pereira</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>camera_calibration</exec_depend>
  <exec_depend>camera_ros</exec_depend>
  <exec_depend>image_proc</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>stereo_image_proc</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
