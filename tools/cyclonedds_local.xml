<!-- Race mode: all ROS traffic stays inside the robot on the loopback
     interface, so a dropped Ethernet/Wi-Fi link cannot cut the nodes off from
     each other (2026-10-01: a cable drop made every node fail to send and
     safety stopped the robot). Discovery is unicast to localhost because
     loopback has no multicast. -->
<CycloneDDS>
  <Domain>
    <General>
      <Interfaces><NetworkInterface name="lo"/></Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <Peers><Peer address="localhost"/></Peers>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>60</MaxAutoParticipantIndex>
    </Discovery>
  </Domain>
</CycloneDDS>
