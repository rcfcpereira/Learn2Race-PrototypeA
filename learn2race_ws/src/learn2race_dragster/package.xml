<?xml version="1.0"?>
<package format="3">
  <!-- Dragster race-start package using a Grove analog light sensor. -->
  <name>learn2race_dragster</name>
  <version>0.1.0</version>
  <description>Light-triggered dragster race start actions for Learn2Race.</description>
  <maintainer email="1181915@isep.ipp.pt">Ruben Pereira</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>learn2race_dragster_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
