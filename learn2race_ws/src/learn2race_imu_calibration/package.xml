<?xml version="1.0"?>
<package format="3">
  <!-- Stationary IMU calibration workflow for the Grove LSM6DS3 IMU. -->
  <name>learn2race_imu_calibration</name>
  <version>0.1.0</version>
  <description>IMU bias and gravity-vector calibration package for Learn2Race.</description>
  <maintainer email="1181915@isep.ipp.pt">Ruben Pereira</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- The launch can start the existing IMU hardware node from bringup. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
